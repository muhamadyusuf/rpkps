// Skema F0 — Fondasi
// Acuan: docs/00-konsep-rpkps.md §4.7 dan docs/03-kebijakan-beban-belajar.md §3
// Cakupan tenancy: SATU institusi, banyak prodi (tanpa kolom tenant di tiap tabel).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"

  /// relationJoins membuka `relationLoadStrategy: "join"`. Tanpa itu Prisma
  /// memuat setiap relasi sebagai kueri terpisah — satu `muatRpkps()` menjadi
  /// 30 perjalanan pulang-pergi ke basis data yang jauh. Strateginya dipasang
  /// sekali untuk seluruh operasi baca di src/lib/prisma.ts, bukan ditulis di
  /// tiap pemanggilan.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ORGANISASI
// ─────────────────────────────────────────────────────────────

model Institusi {
  id          String   @id @default(cuid())
  nama        String
  namaEn      String?  @map("nama_en")
  namaSingkat String   @map("nama_singkat")
  kodePt      String?  @map("kode_pt")
  alamat      String?
  situs       String?
  logoUrl     String?  @map("logo_url")
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")
  diubahPada  DateTime @updatedAt @map("diubah_pada")

  fakultas  Fakultas[]
  kebijakan KebijakanBebanBelajar[]

  @@map("institusi")
}

model Fakultas {
  id          String   @id @default(cuid())
  institusiId String   @map("institusi_id")
  nama        String
  namaEn      String?  @map("nama_en")
  kode        String   @unique
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")
  diubahPada  DateTime @updatedAt @map("diubah_pada")

  institusi Institusi @relation(fields: [institusiId], references: [id], onDelete: Cascade)
  prodi     Prodi[]

  @@index([institusiId])
  @@map("fakultas")
}

enum JenjangProdi {
  D3
  D4
  S1
  S2
  S3
  PROFESI
}

model Prodi {
  id         String       @id @default(cuid())
  fakultasId String       @map("fakultas_id")
  nama       String
  namaEn     String?      @map("nama_en")
  kode       String       @unique
  jenjang    JenjangProdi @default(S1)
  gelar      String?
  akreditasi String?
  aktif      Boolean      @default(true)
  dibuatPada DateTime     @default(now()) @map("dibuat_pada")
  diubahPada DateTime     @updatedAt @map("diubah_pada")

  fakultas  Fakultas         @relation(fields: [fakultasId], references: [id], onDelete: Restrict)
  penugasan PenugasanPeran[]
  kurikulum Kurikulum[]
  mahasiswa Mahasiswa[]

  @@index([fakultasId])
  @@map("prodi")
}

enum SemesterTipe {
  GANJIL
  GENAP
  ANTARA
}

model TahunAkademik {
  id                 String       @id @default(cuid())
  kode               String       @unique // contoh: "2025/2026-GENAP"
  tahunMulai         Int          @map("tahun_mulai")
  tahunSelesai       Int          @map("tahun_selesai")
  semester           SemesterTipe
  tanggalMulai       DateTime?    @map("tanggal_mulai")
  tanggalAkhir       DateTime?    @map("tanggal_akhir")
  /// Tiga tenggat, satu untuk tiap petak tanggung jawab di rantai pengesahan
  /// (docs/14 §3). Tanggal, bukan aturan: tidak ada yang dikunci saat
  /// terlampaui — yang berubah hanya urgensi pada antrian kerja dan daftar.
  ///
  /// Satu dokumen hanya terikat SATU tenggat pada satu waktu, dan pemiliknya
  /// berpindah mengikuti status: penyusunan → dosen, review → Kaprodi,
  /// pengesahan → Penjaminan Mutu.
  tenggatPenyusunan  DateTime?    @map("tenggat_penyusunan")
  tenggatReview      DateTime?    @map("tenggat_review")
  tenggatPengesahan  DateTime?    @map("tenggat_pengesahan")
  /// Hari yang dijamin bagi pemutus, dihitung sejak dokumen sampai padanya.
  /// LANTAI, bukan langit-langit: dokumen yang masuk jauh-jauh hari tetap
  /// terikat tanggal semester, sedangkan yang masuk mepet tidak menghukum
  /// pemutusnya atas keterlambatan orang lain (docs/14 §3.2).
  jaminanHariPutusan Int          @default(7) @map("jaminan_hari_putusan")
  aktif              Boolean      @default(false)
  dibuatPada         DateTime     @default(now()) @map("dibuat_pada")
  diubahPada         DateTime     @updatedAt @map("diubah_pada")
  rpkps              Rpkps[]

  usulanBerlaku  UsulanRevisi[]    @relation("UsulanBerlaku")
  revisiBerlaku  RevisiKurikulum[] @relation("RevisiBerlaku")
  temuanSasaran  TemuanEvaluasi[]  @relation("TemuanSasaran")
  cpmkPensiun    Cpmk[]            @relation("CpmkPensiun")
  subCpmkPensiun SubCpmk[]         @relation("SubCpmkPensiun")
  koordinatorMk  KoordinatorMk[]

  @@index([aktif])
  @@map("tahun_akademik")
}

// ─────────────────────────────────────────────────────────────
// PENGGUNA & PERAN
// Identitas (login) ditangani Firebase Auth. Tabel ini menyimpan
// PROFIL KEPEGAWAIAN yang tidak boleh berada di layanan pihak ketiga:
// NIDN/NIP, peran, dan cakupan prodi. Dikelola oleh Admin.
// ─────────────────────────────────────────────────────────────

/// Bahasa antarmuka pilihan pengguna.
///
/// Nilainya sengaja huruf kecil dan sama persis dengan ruas alamat (`/id`,
/// `/en`) serta cookie `bahasa`. Enum berhuruf besar akan memaksa konversi
/// bentuk di tiga tempat sekaligus, dan konversi itulah yang salah.
enum BahasaAntarmuka {
  id
  en
}

enum StatusPengguna {
  AKTIF
  NONAKTIF
  MENUNGGU_VERIFIKASI
}

model Pengguna {
  id            String          @id @default(cuid())
  firebaseUid   String          @unique @map("firebase_uid")
  email         String          @unique
  nama          String
  gelarDepan    String?         @map("gelar_depan")
  gelarBelakang String?         @map("gelar_belakang")
  nidn          String?         @unique
  nip           String?         @unique
  nik           String?         @unique
  telepon       String?
  fotoUrl       String?         @map("foto_url")
  status        StatusPengguna  @default(MENUNGGU_VERIFIKASI)
  /// Preferensi bahasa antarmuka. Mengikuti ORANGNYA lintas perangkat;
  /// cookie `bahasa` hanya menyimpan yang terakhir dipakai di peramban ini.
  bahasa        BahasaAntarmuka @default(id)
  terakhirMasuk DateTime?       @map("terakhir_masuk")
  dibuatPada    DateTime        @default(now()) @map("dibuat_pada")
  diubahPada    DateTime        @updatedAt @map("diubah_pada")

  penugasan          PenugasanPeran[]
  logAudit           LogAudit[]
  pengampuRpkps      RpkpsPengampu[]
  usulanDiajukan     UsulanRevisi[]     @relation("UsulanDiajukan")
  usulanDiputuskan   UsulanRevisi[]     @relation("UsulanDiputuskan")
  catatanUsulan      CatatanUsulan[]
  revisiKurikulum    RevisiKurikulum[]
  kelasDiampu        Kelas[]            @relation("KelasDosen")
  evaluasiDitutup    EvaluasiMk[]       @relation("EvaluasiDitutup")
  temuanDitanggung   TemuanEvaluasi[]   @relation("TemuanPenanggungJawab")
  temuanDiverifikasi TemuanEvaluasi[]   @relation("TemuanDiverifikasi")
  kredensialAi       KredensialAi[]
  notifikasi         Notifikasi[]
  koordinatorMk      KoordinatorMk[]    @relation("KoordinatorMkDosen")
  koordinatorMkSet   KoordinatorMk[]    @relation("KoordinatorMkPenetap")
  tandaTanganRpkps   TandaTanganRpkps[]

  @@index([status])
  @@map("pengguna")
}

/// Peran ditulis sebagai enum, bukan tabel, karena himpunannya tetap dan
/// dipakai untuk pengecekan otorisasi di kode.
enum Peran {
  ADMIN // administrator sistem
  KAPRODI // ketua program studi
  GPM // gugus/kepala penjaminan mutu
  KOORDINATOR_MK // koordinator mata kuliah
  DOSEN // dosen pengampu
  MAHASISWA
  ASESOR // akses baca terbatas untuk audit/akreditasi
}

/// Satu pengguna dapat memegang beberapa peran, masing-masing dengan
/// cakupan prodi. prodiId null = cakupan institusi (mis. ADMIN, GPM).
model PenugasanPeran {
  id         String   @id @default(cuid())
  penggunaId String   @map("pengguna_id")
  peran      Peran
  prodiId    String?  @map("prodi_id")
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  prodi    Prodi?   @relation(fields: [prodiId], references: [id], onDelete: Cascade)

  /// CATATAN: pada Postgres, NULL dianggap berbeda satu sama lain di dalam
  /// UNIQUE, sehingga constraint ini TIDAK mencegah duplikat ketika prodiId
  /// null (peran bercakupan institusi seperti ADMIN/GPM). Indeks partial
  /// untuk kasus itu ditambahkan lewat migrasi SQL manual —
  /// lihat prisma/migrations/*_penugasan_peran_null_unik.
  @@unique([penggunaId, peran, prodiId])
  @@index([penggunaId])
  @@index([prodiId])
  @@map("penugasan_peran")
}

// ─────────────────────────────────────────────────────────────
// KEBIJAKAN BEBAN BELAJAR
// Acuan: docs/03-kebijakan-beban-belajar.md §3
// Menegakkan invarian: total beban / sks = 45 jam per semester.
// ─────────────────────────────────────────────────────────────

enum StatusKebijakan {
  DRAF
  BERLAKU
  ARSIP
}

model KebijakanBebanBelajar {
  id            String          @id @default(cuid())
  institusiId   String          @map("institusi_id")
  nama          String
  status        StatusKebijakan @default(DRAF)
  berlakuDari   DateTime        @map("berlaku_dari")
  berlakuSampai DateTime?       @map("berlaku_sampai")

  mingguPerSemester        Int     @default(16) @map("minggu_per_semester")
  pertemuanEfektifTeori    Int     @default(14) @map("pertemuan_efektif_teori")
  pertemuanEfektifPraktik  Int     @default(14) @map("pertemuan_efektif_praktik")
  /// Bila true, minggu UTS & UAS ikut dihitung sebagai beban belajar.
  /// Lihat docs/03 §2.1 — bila false, invarian 45 jam/sks tidak akan tercapai.
  hitungMingguUjian        Boolean @default(true) @map("hitung_minggu_ujian")
  /// Menit tatap muka pada minggu ujian (pelaksanaan UTS/UAS). Sisa pagu
  /// minggu ujian jatuh ke belajar mandiri sebagai persiapan ujian.
  menitTmPerUjian          Int     @default(120) @map("menit_tm_per_ujian")
  jamPerSksPerSemester     Decimal @default(45) @map("jam_per_sks_per_semester") @db.Decimal(5, 2)
  toleransiSemesterPersen  Decimal @default(5) @map("toleransi_semester_persen") @db.Decimal(5, 2)
  toleransiPertemuanPersen Decimal @default(10) @map("toleransi_pertemuan_persen") @db.Decimal(5, 2)

  catatan    String?
  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  institusi Institusi         @relation(fields: [institusiId], references: [id], onDelete: Cascade)
  bentuk    KebijakanBentuk[]

  @@index([institusiId, status])
  @@map("kebijakan_beban_belajar")
}

enum BentukPembelajaran {
  KULIAH
  RESPONSI
  TUTORIAL
  SEMINAR
  PRAKTIKUM
  PRAKTIK_STUDIO
  PRAKTIK_BENGKEL
  PRAKTIK_LAPANGAN
  PENELITIAN
  PKM
  KKN
}

/// Menit per sks per minggu, dipecah tiga agar dua pertanyaan berbeda
/// bisa dijawab dari data yang sama:
///   menitTm            → kebutuhan slot ruang/lab (penjadwalan)
///   menitTm+Pt+Bm      → kepatuhan terhadap 45 jam/sks (docs/03 §1.1)
model KebijakanBentuk {
  id               String             @id @default(cuid())
  kebijakanId      String             @map("kebijakan_id")
  bentuk           BentukPembelajaran
  menitTmPerSks    Int                @map("menit_tm_per_sks")
  menitPtPerSks    Int                @map("menit_pt_per_sks")
  menitBmPerSks    Int                @map("menit_bm_per_sks")
  tmTerjadwal      Boolean            @default(true) @map("tm_terjadwal")
  butuhRuangKhusus Boolean            @default(false) @map("butuh_ruang_khusus")

  kebijakan KebijakanBebanBelajar @relation(fields: [kebijakanId], references: [id], onDelete: Cascade)

  @@unique([kebijakanId, bentuk])
  @@map("kebijakan_bentuk")
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model LogAudit {
  id         String   @id @default(cuid())
  penggunaId String?  @map("pengguna_id")
  aksi       String
  entitas    String
  entitasId  String?  @map("entitas_id")
  ringkasan  String?
  data       Json?
  ip         String?
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  pengguna Pengguna? @relation(fields: [penggunaId], references: [id], onDelete: SetNull)

  @@index([entitas, entitasId])
  @@index([penggunaId])
  @@index([dibuatPada])
  @@map("log_audit")
}

/// Peristiwa yang layak mengganggu seseorang. Sengaja sedikit: notifikasi yang
/// terlalu sering dikirim berhenti dibaca, dan yang berhenti dibaca sama saja
/// dengan tidak ada.
enum JenisNotifikasi {
  RPKPS_DIAJUKAN
  RPKPS_DISETUJUI
  RPKPS_MENUNGGU_PENGESAHAN
  RPKPS_DISAHKAN
  RPKPS_DIREVISI
  RPKPS_PENGAMPU
  KOORDINATOR_MK_DITETAPKAN
  USULAN_DIAJUKAN
  USULAN_DIPUTUSKAN
}

/// Kabar untuk SATU orang. Satu peristiwa yang menyangkut lima orang menjadi
/// lima baris — dibaca dan ditandai masing-masing, tanpa tabel penerima.
///
/// Bukan `log_audit`: yang di sana adalah catatan resmi yang tidak pernah
/// dihapus dan tidak dialamatkan kepada siapa pun. Yang di sini boleh basi.
model Notifikasi {
  id         String          @id @default(cuid())
  penggunaId String          @map("pengguna_id")
  jenis      JenisNotifikasi
  /// Kunci kalimat + parameternya: { kunci, params }. Kalimatnya dirakit saat
  /// DIBACA, dalam bahasa pembacanya (docs/11 §4.2). Kosong pada baris yang
  /// ditulis sebelum L3 — baris itu memakai judul/ringkasan di bawah.
  data       Json?
  /// Cadangan bahasa Indonesia. Dipertahankan supaya baris lama tetap terbaca
  /// dan supaya notifikasi tetap punya isi bila kuncinya hilang dari kamus.
  judul      String
  ringkasan  String
  /// Alamat di dalam aplikasi yang menjawab notifikasi ini.
  tautan     String?
  entitas    String?
  entitasId  String?         @map("entitas_id")
  dibacaPada DateTime?       @map("dibaca_pada")
  dibuatPada DateTime        @default(now()) @map("dibuat_pada")

  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([penggunaId, dibacaPada])
  @@index([penggunaId, dibuatPada])
  @@map("notifikasi")
}

/// Penyedia LLM yang adapternya ada di src/lib/ai/penyedia/.
enum PenyediaAi {
  ANTHROPIC
  MISTRAL
  GEMINI
}

/// Kunci API milik SATU dosen — BYOK Mode A, docs/08.
///
/// Kolom `scope` yang dirancang docs/01 §2.1 sengaja TIDAK dibuat: Mode A
/// hanya mengenal kunci pengguna, dan kolom yang selalu bernilai sama adalah
/// kolom mati. Ia ditambahkan bersama jalur cadangan yang memakainya, bukan
/// sekarang sebagai ornamen.
model KredensialAi {
  id         String     @id @default(cuid())
  penggunaId String     @map("pengguna_id")
  penyedia   PenyediaAi
  /// Nama yang dosen kenali, mis. "Kunci pribadi saya".
  label      String

  /// Enkripsi amplop AES-256-GCM; tata letaknya di src/lib/kripto/amplop.ts.
  /// Tidak pernah dapat dibaca kembali lewat antarmuka mana pun, hanya diganti.
  kunciTerenkripsi Bytes  @map("kunci_terenkripsi")
  /// Empat karakter terakhir, teks biasa. Cukup untuk mengenali kunci yang
  /// mana, tidak cukup untuk memakainya.
  ekor             String

  /// Kosong berarti memakai model bawaan adapter penyedianya. Model melekat di
  /// sini, bukan di variabel lintas-penyedia, karena namanya tidak pernah
  /// cocok antar penyedia.
  model String?

  bawaan          Boolean   @default(false)
  aktif           Boolean   @default(true)
  terakhirDipakai DateTime? @map("terakhir_dipakai")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@unique([penggunaId, penyedia, label])
  @@index([penggunaId])
  @@map("kredensial_ai")
}

// ─────────────────────────────────────────────────────────────
// KURIKULUM
// Acuan: docs/02-template-itts-dan-penyelarasan-industri.md §3.1
//
// Ini adalah SUMBER KEBENARAN untuk CPL, CPMK, dan Sub-CPMK.
// Di penyusun RPKPS ketiganya bersifat read-only; perubahan harus
// lewat Usulan Revisi Kurikulum ke Ketua Program Studi.
// ─────────────────────────────────────────────────────────────

enum StatusKurikulum {
  DRAF
  BERLAKU
  ARSIP
}

model Kurikulum {
  id          String          @id @default(cuid())
  prodiId     String          @map("prodi_id")
  nama        String
  tahun       Int
  status      StatusKurikulum @default(DRAF)
  berlakuDari DateTime?       @map("berlaku_dari")
  catatan     String?
  /// Penghitung amandemen yang disahkan. Naik satu tiap Usulan Revisi
  /// diterapkan; jejak rincinya di RevisiKurikulum (doc 04 §2.5).
  revisi      Int             @default(0)
  dibuatPada  DateTime        @default(now()) @map("dibuat_pada")
  diubahPada  DateTime        @updatedAt @map("diubah_pada")

  prodi         Prodi             @relation(fields: [prodiId], references: [id], onDelete: Cascade)
  profilLulusan ProfilLulusan[]
  cpl           Cpl[]
  bahanKajian   BahanKajian[]
  mataKuliah    MataKuliah[]
  usulan        UsulanRevisi[]
  daftarRevisi  RevisiKurikulum[]

  @@unique([prodiId, tahun])
  @@index([prodiId, status])
  @@map("kurikulum")
}

model ProfilLulusan {
  id          String  @id @default(cuid())
  kurikulumId String  @map("kurikulum_id")
  kode        String // "PL1"
  deskripsi   String
  deskripsiEn String? @map("deskripsi_en")
  urutan      Int     @default(0)

  kurikulum Kurikulum          @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  cpl       CplProfilLulusan[]

  @@unique([kurikulumId, kode])
  @@map("profil_lulusan")
}

/// Ranah CPL menurut SN-Dikti.
enum RanahCpl {
  SIKAP
  PENGETAHUAN
  KETERAMPILAN_UMUM
  KETERAMPILAN_KHUSUS
}

model Cpl {
  id          String   @id @default(cuid())
  kurikulumId String   @map("kurikulum_id")
  kode        String // "CPL06"
  deskripsi   String
  deskripsiEn String?  @map("deskripsi_en")
  ranah       RanahCpl @default(KETERAMPILAN_KHUSUS)
  tingkatKkni Int?     @map("tingkat_kkni")
  urutan      Int      @default(0)

  kurikulum     Kurikulum          @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  profilLulusan CplProfilLulusan[]
  mataKuliah    MatriksCplMk[]
  cpmk          PetaCpmkCpl[]

  @@unique([kurikulumId, kode])
  @@map("cpl")
}

model CplProfilLulusan {
  cplId           String @map("cpl_id")
  profilLulusanId String @map("profil_lulusan_id")

  cpl           Cpl           @relation(fields: [cplId], references: [id], onDelete: Cascade)
  profilLulusan ProfilLulusan @relation(fields: [profilLulusanId], references: [id], onDelete: Cascade)

  @@id([cplId, profilLulusanId])
  @@map("cpl_profil_lulusan")
}

model BahanKajian {
  id          String  @id @default(cuid())
  kurikulumId String  @map("kurikulum_id")
  kode        String
  /// Tabel ini belum punya satu pun penulis maupun pembaca di aplikasi, jadi
  /// kolom cermin `*_en` sengaja TIDAK ada: ia tak akan pernah bisa diisi
  /// siapa pun (docs/11 §5.1a).
  nama        String
  deskripsi   String?

  kurikulum Kurikulum @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)

  @@unique([kurikulumId, kode])
  @@map("bahan_kajian")
}

enum StatusMataKuliah {
  WAJIB
  PILIHAN
  WAJIB_UMUM
}

model MataKuliah {
  id          String           @id @default(cuid())
  kurikulumId String           @map("kurikulum_id")
  kode        String // "TI214"
  nama        String
  namaEn      String?          @map("nama_en")
  deskripsi   String?
  deskripsiEn String?          @map("deskripsi_en")
  semester    Int
  status      StatusMataKuliah @default(WAJIB)

  /// sks dipecah teori dan praktik. Totalnya tidak berubah, tetapi beban
  /// TERJADWAL berbeda jauh — lihat docs/03 §2.2.
  sksTeori      Int                @map("sks_teori")
  sksPraktik    Int                @default(0) @map("sks_praktik")
  bentukTeori   BentukPembelajaran @default(KULIAH) @map("bentuk_teori")
  bentukPraktik BentukPembelajaran @default(PRAKTIKUM) @map("bentuk_praktik")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  kurikulum            Kurikulum       @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  cpl                  MatriksCplMk[]
  cpmk                 Cpmk[]
  prasyarat            MkPrasyarat[]   @relation("MkUtama")
  menjadiPrasyaratBagi MkPrasyarat[]   @relation("MkPrasyarat")
  rpkps                Rpkps[]
  usulan               UsulanRevisi[]
  koordinator          KoordinatorMk[]

  @@unique([kurikulumId, kode])
  @@index([kurikulumId, semester])
  @@map("mata_kuliah")
}

/// Penugasan dosen koordinator sebuah mata kuliah untuk SATU tahun akademik
/// (docs/13-penugasan-koordinator-mk.md §2.1).
///
/// Sengaja BUKAN kolom `koordinator_id` pada `mata_kuliah`: pemegang MK
/// berganti tiap semester, dan satu kolom berarti pergantian menimpa pemegang
/// sebelumnya sampai tidak ada lagi yang dapat menjawab siapa yang memegang MK
/// itu dua tahun lalu. Baris tersendiri per tahun akademik ITULAH riwayatnya.
///
/// Yang tidak tercatat di sini: pergantian di tengah satu tahun akademik —
/// `@@unique` membuatnya menimpa baris yang sama. Jejaknya di `log_audit` dan,
/// bila RPKPS-nya sudah ada, di `rpkps_riwayat` lewat serah terima yang ikut
/// dijalankan.
model KoordinatorMk {
  id               String  @id @default(cuid())
  mataKuliahId     String  @map("mata_kuliah_id")
  tahunAkademikId  String  @map("tahun_akademik_id")
  penggunaId       String  @map("pengguna_id")
  /// Penetapnya boleh hilang tanpa melenyapkan penugasannya (SetNull), sebab
  /// yang penting di sini adalah SIAPA YANG DITUGASKAN, bukan siapa yang menugaskan.
  ditetapkanOlehId String? @map("ditetapkan_oleh_id")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  mataKuliah     MataKuliah    @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  tahunAkademik  TahunAkademik @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)
  pengguna       Pengguna      @relation("KoordinatorMkDosen", fields: [penggunaId], references: [id], onDelete: Cascade)
  ditetapkanOleh Pengguna?     @relation("KoordinatorMkPenetap", fields: [ditetapkanOlehId], references: [id], onDelete: SetNull)

  @@unique([mataKuliahId, tahunAkademikId])
  @@index([tahunAkademikId])
  @@index([penggunaId, tahunAkademikId])
  @@map("koordinator_mk")
}

enum JenisPrasyarat {
  PRASYARAT
  BERSAMAAN
}

model MkPrasyarat {
  id            String         @id @default(cuid())
  mataKuliahId  String         @map("mata_kuliah_id")
  prasyaratMkId String         @map("prasyarat_mk_id")
  jenis         JenisPrasyarat @default(PRASYARAT)

  mataKuliah  MataKuliah @relation("MkUtama", fields: [mataKuliahId], references: [id], onDelete: Cascade)
  prasyaratMk MataKuliah @relation("MkPrasyarat", fields: [prasyaratMkId], references: [id], onDelete: Cascade)

  @@unique([mataKuliahId, prasyaratMkId])
  @@map("mk_prasyarat")
}

/// Matriks CPL x MK — CPL mana yang dibebankan pada mata kuliah mana.
model MatriksCplMk {
  cplId        String @map("cpl_id")
  mataKuliahId String @map("mata_kuliah_id")

  cpl        Cpl        @relation(fields: [cplId], references: [id], onDelete: Cascade)
  mataKuliah MataKuliah @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)

  @@id([cplId, mataKuliahId])
  @@map("matriks_cpl_mk")
}

/// Level taksonomi Bloom revisi. C = kognitif, A = afektif, P = psikomotor.
enum LevelBloom {
  C1
  C2
  C3
  C4
  C5
  C6
  A1
  A2
  A3
  A4
  A5
  P1
  P2
  P3
  P4
  P5
}

/// Asal isi sebuah rumusan. Dipakai menjawab pertanyaan asesor: bagian mana
/// dari dokumen ini yang dihasilkan AI. Acuan: docs/01 §4.8 field_provenance.
enum SumberIsi {
  KURIKULUM
  AI
}

model Cpmk {
  id           String      @id @default(cuid())
  mataKuliahId String      @map("mata_kuliah_id")
  kode         String // "CPMK081"
  rumusan      String
  rumusanEn    String?     @map("rumusan_en")
  levelBloom   LevelBloom? @map("level_bloom")
  urutan       Int         @default(0)
  sumber       SumberIsi   @default(KURIKULUM)

  /// Null = masih aktif. Terisi berarti CPMK ini tidak lagi ditawarkan
  /// untuk RPKPS mulai tahun akademik tersebut. TIDAK PERNAH dihapus:
  /// Sub-CPMK-nya dirujuk pertemuan, tugas, dan kisi-kisi RPKPS lama
  /// dengan onDelete Cascade (doc 04 §2.4).
  pensiunSejakTaId String? @map("pensiun_sejak_ta_id")

  mataKuliah     MataKuliah     @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  pensiunSejakTa TahunAkademik? @relation("CpmkPensiun", fields: [pensiunSejakTaId], references: [id], onDelete: SetNull)
  cpl            PetaCpmkCpl[]
  subCpmk        SubCpmk[]
  butirUsulan    ButirUsulan[]

  @@unique([mataKuliahId, kode])
  @@map("cpmk")
}

model PetaCpmkCpl {
  cpmkId String @map("cpmk_id")
  cplId  String @map("cpl_id")

  cpmk Cpmk @relation(fields: [cpmkId], references: [id], onDelete: Cascade)
  cpl  Cpl  @relation(fields: [cplId], references: [id], onDelete: Cascade)

  @@id([cpmkId, cplId])
  @@map("peta_cpmk_cpl")
}

model SubCpmk {
  id               String      @id @default(cuid())
  cpmkId           String      @map("cpmk_id")
  /// ITTS memakai pola "CPMK081-1". Pola kode mengikuti kebiasaan institusi.
  kode             String
  rumusan          String
  rumusanEn        String?     @map("rumusan_en")
  levelBloom       LevelBloom? @map("level_bloom")
  kko              String?
  urutan           Int         @default(0)
  sumber           SumberIsi   @default(KURIKULUM)
  /// Usulan minggu pelaksanaan dari kurikulum. RPKPS boleh menyusun ulang.
  mingguDisarankan Int[]       @map("minggu_disarankan")

  /// Lihat catatan pensiun pada Cpmk.
  pensiunSejakTaId String? @map("pensiun_sejak_ta_id")

  cpmk           Cpmk               @relation(fields: [cpmkId], references: [id], onDelete: Cascade)
  pensiunSejakTa TahunAkademik?     @relation("SubCpmkPensiun", fields: [pensiunSejakTaId], references: [id], onDelete: SetNull)
  pertemuan      PertemuanSubCpmk[]
  tugas          TugasSubCpmk[]
  butirUjian     ButirKisiKisi[]
  butirUsulan    ButirUsulan[]

  @@unique([cpmkId, kode])
  @@map("sub_cpmk")
}

// ─────────────────────────────────────────────────────────────
// RPKPS
// Acuan: docs/02-template-itts-dan-penyelarasan-industri.md §1.1–1.3
//
// Struktur mengikuti template ITTS (bagian A–J). CPL/CPMK/Sub-CPMK TIDAK
// disalin ke sini — dirujuk dari kurikulum agar tetap satu sumber kebenaran.
// ─────────────────────────────────────────────────────────────

enum StatusRpkps {
  DRAF
  DIAJUKAN
  DIREVISI
  DISETUJUI
  TERBIT
  ARSIP
}

model Rpkps {
  id              String      @id @default(cuid())
  mataKuliahId    String      @map("mata_kuliah_id")
  tahunAkademikId String      @map("tahun_akademik_id")
  status          StatusRpkps @default(DRAF)
  versi           Int         @default(1)

  /// Bagian A pada template ITTS.
  deskripsi            String?
  deskripsiEn          String? @map("deskripsi_en")
  /// Kalimat pembuka sebelum daftar CPMK, mis. "Setelah menyelesaikan mata
  /// kuliah ini, mahasiswa akan mampu…". Milik prodi, bukan milik CPMK.
  kalimatPembukaCpmk   String? @map("kalimat_pembuka_cpmk")
  kalimatPembukaCpmkEn String? @map("kalimat_pembuka_cpmk_en")

  /// Bagian F pada template ITTS.
  ambangKelulusanMhs     Decimal @default(55) @map("ambang_kelulusan_mhs") @db.Decimal(5, 2)
  ambangKetercapaianMk   Decimal @default(85) @map("ambang_ketercapaian_mk") @db.Decimal(5, 2)
  minimalKehadiranPersen Int     @default(80) @map("minimal_kehadiran_persen")
  /// Tidak punya kembaran `catatan_evaluasi_en`: kolom ini sendiri belum
  /// ditulis maupun dibaca di mana pun (docs/11 §5.1a).
  catatanEvaluasi        String? @map("catatan_evaluasi")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  mataKuliah    MataKuliah         @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik      @relation(fields: [tahunAkademikId], references: [id], onDelete: Restrict)
  pengampu      RpkpsPengampu[]
  pustaka       Pustaka[]
  pertemuan     Pertemuan[]
  komponenNilai KomponenNilai[]
  riwayat       RpkpsRiwayat[]
  snapshot      RpkpsSnapshot[]
  kisiKisi      KisiKisi[]
  tugas         Tugas[]
  kelas         Kelas[]
  tandaTangan   TandaTanganRpkps[]
  bukuAjar      BukuAjar[]

  @@unique([mataKuliahId, tahunAkademikId])
  @@index([status])
  @@map("rpkps")
}

enum PeranPengampu {
  KOORDINATOR
  ANGGOTA
}

model RpkpsPengampu {
  id         String        @id @default(cuid())
  rpkpsId    String        @map("rpkps_id")
  penggunaId String        @map("pengguna_id")
  peran      PeranPengampu @default(ANGGOTA)
  urutan     Int           @default(0)

  rpkps    Rpkps    @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@unique([rpkpsId, penggunaId])
  @@map("rpkps_pengampu")
}

// ─────────────────────────────────────────────────────────────
// RANTAI PENGESAHAN — docs/14 §2
//
// Empat cap berurutan, persis seperti Halaman Pengesahan template ITTS:
// paraf tiap pengampu → koordinator (a.n tim penyusun) → Ketua Program Studi
// (disetujui) → Kepala Penjaminan Mutu (sesuai standar ITTS). Cap terakhir
// itulah yang menerbitkan dokumen, bukan persetujuan Kaprodi.
// ─────────────────────────────────────────────────────────────

enum PeranTtd {
  PENGAMPU // kolom "Tanda Tangan" pada tabel Tim Dosen Pengampu
  KOORDINATOR // "a.n Tim penyusun RPKPS"
  KAPRODI // "Disetujui oleh,"
  PENJAMINAN_MUTU // "Telah diperiksa dan dinyatakan sesuai dengan standar ITTS"
}

model TandaTanganRpkps {
  id      String   @id @default(cuid())
  rpkpsId String   @map("rpkps_id")
  /// Ronde persetujuan; mengikuti `rpkps.versi` saat ditandatangani.
  /// Pengembalian untuk revisi menaikkan versi, dan kenaikan itulah yang
  /// MENGGUGURKAN seluruh tanda tangan ronde sebelumnya — barisnya tidak
  /// dihapus, karena riwayat siapa menandatangani isi yang mana justru bagian
  /// yang paling berguna saat ada sengketa.
  versi   Int
  peran   PeranTtd

  penggunaId String  @map("pengguna_id")
  /// Nama dan identitas SAAT menandatangani, dibekukan. Alasannya sama dengan
  /// nama pengampu pada `rpkps_snapshot`: memperbarui nama yang sudah tercetak
  /// menggeser dokumen yang sudah resmi.
  nama       String
  identitas  String? // NIDN / NIP / NIK saat itu

  /// Sidik SHA-256 isi yang ditandatangani. Inilah yang membuat tanda tangan
  /// berarti: tanpa menyebut apa yang ditandatangani, ia tidak membuktikan
  /// apa pun. `sahkanRpkps` menolak bila sidik sudah bergeser sejak dicap.
  ///
  /// Pengembalian untuk revisi TIDAK menulis baris di sini. Ia bukan tanda
  /// tangan, dan mencatatnya sebagai cap KAPRODI akan membuat penolakan
  /// terbaca sebagai persetujuan. Catatannya tetap di `rpkps_riwayat`.
  sidik              String
  ditandatanganiPada DateTime @default(now()) @map("ditandatangani_pada")

  rpkps    Rpkps    @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  /// Restrict, bukan Cascade: pengguna yang pernah menandatangani dokumen
  /// resmi tidak boleh lenyap dan meninggalkan tanda tangan tanpa penanda
  /// tangan.
  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Restrict)

  @@unique([rpkpsId, versi, peran, penggunaId])
  @@index([rpkpsId, versi])
  @@map("tanda_tangan_rpkps")
}

/// Bagian G template ITTS. Kategori "TOOLS" tidak ada di format generik
/// Diktiristek, tetapi penting untuk mata kuliah praktik.
enum JenisPustaka {
  UTAMA
  PENDUKUNG
  DARING
  TOOLS
}

model Pustaka {
  id      String       @id @default(cuid())
  rpkpsId String       @map("rpkps_id")
  jenis   JenisPustaka @default(UTAMA)
  nomor   Int
  teks    String
  url     String?
  sumber  SumberIsi    @default(KURIKULUM)

  rpkps     Rpkps              @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  pertemuan PertemuanPustaka[]
  bab       BabPustaka[]

  @@unique([rpkpsId, jenis, nomor])
  @@map("pustaka")
}

enum JenisPertemuan {
  EFEKTIF
  UTS
  UAS
}

/// Satu baris pada tabel mingguan (bagian H template ITTS).
model Pertemuan {
  id      String         @id @default(cuid())
  rpkpsId String         @map("rpkps_id")
  minggu  Int
  jenis   JenisPertemuan @default(EFEKTIF)

  topik      String?
  topikEn    String?  @map("topik_en")
  subtopik   String[]
  subtopikEn String[] @map("subtopik_en")

  /// Narasi bebas pada kolom "Metode dan Aktivitas Pembelajaran".
  metodeNarasi         String? @map("metode_narasi")
  metodeNarasiEn       String? @map("metode_narasi_en")
  aktivitasDosen       String? @map("aktivitas_dosen")
  aktivitasDosenEn     String? @map("aktivitas_dosen_en")
  aktivitasMahasiswa   String? @map("aktivitas_mahasiswa")
  aktivitasMahasiswaEn String? @map("aktivitas_mahasiswa_en")
  tugasTerstruktur     String? @map("tugas_terstruktur")
  tugasTerstrukturEn   String? @map("tugas_terstruktur_en")

  /// Kolom "Penilaian" bercabang tiga pada template ITTS.
  penilaianJenis    String? @map("penilaian_jenis")
  penilaianJenisEn  String? @map("penilaian_jenis_en")
  penilaianSistem   String? @map("penilaian_sistem")
  penilaianSistemEn String? @map("penilaian_sistem_en")
  bobot             Decimal @default(0) @db.Decimal(5, 2)

  komponenNilaiId String?   @map("komponen_nilai_id")
  sumber          SumberIsi @default(KURIKULUM)

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  /// Dipakai sebagai kunci optimistik oleh `simpanPertemuan`: penyimpanan
  /// hanya lolos bila cap ini masih sama dengan yang dibaca penyunting.
  diubahPada DateTime @updatedAt @map("diubah_pada")

  rpkps         Rpkps              @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  komponenNilai KomponenNilai?     @relation(fields: [komponenNilaiId], references: [id], onDelete: SetNull)
  subCpmk       PertemuanSubCpmk[]
  aktivitas     AktivitasBelajar[]
  indikator     Indikator[]
  pustaka       PertemuanPustaka[]
  babBukuAjar   BabBukuAjar[]

  @@unique([rpkpsId, minggu])
  @@index([rpkpsId])
  @@map("pertemuan")
}

model PertemuanSubCpmk {
  pertemuanId String @map("pertemuan_id")
  subCpmkId   String @map("sub_cpmk_id")

  pertemuan Pertemuan @relation(fields: [pertemuanId], references: [id], onDelete: Cascade)
  subCpmk   SubCpmk   @relation(fields: [subCpmkId], references: [id], onDelete: Cascade)

  @@id([pertemuanId, subCpmkId])
  @@map("pertemuan_sub_cpmk")
}

enum KategoriWaktu {
  TM
  PT
  BM
}

enum ModePembelajaran {
  LURING
  DARING_SINKRON
  DARING_ASINKRON
}

/// Butir aktivitas beserta durasinya. Inilah yang dijumlahkan Neraca Waktu
/// dan dibandingkan dengan pagu dari kebijakan beban belajar.
model AktivitasBelajar {
  id          String           @id @default(cuid())
  pertemuanId String           @map("pertemuan_id")
  nama        String
  namaEn      String?          @map("nama_en")
  kategori    KategoriWaktu
  mode        ModePembelajaran @default(LURING)
  /// Tidak punya kembaran `metode_en`: kolom ini sendiri tidak ditulis
  /// penyunting mana pun dan tidak dibaca satu tampilan pun. Mencerminkannya
  /// berarti menambah kolom yang tak akan pernah bisa diisi siapa pun.
  metode      String?
  menit       Int
  urutan      Int              @default(0)

  pertemuan Pertemuan @relation(fields: [pertemuanId], references: [id], onDelete: Cascade)

  @@index([pertemuanId])
  @@map("aktivitas_belajar")
}

model Indikator {
  id          String  @id @default(cuid())
  pertemuanId String  @map("pertemuan_id")
  teks        String
  teksEn      String? @map("teks_en")
  urutan      Int     @default(0)

  pertemuan Pertemuan @relation(fields: [pertemuanId], references: [id], onDelete: Cascade)

  @@index([pertemuanId])
  @@map("indikator")
}

model PertemuanPustaka {
  pertemuanId String  @map("pertemuan_id")
  pustakaId   String  @map("pustaka_id")
  catatan     String?
  catatanEn   String? @map("catatan_en")

  pertemuan Pertemuan @relation(fields: [pertemuanId], references: [id], onDelete: Cascade)
  pustaka   Pustaka   @relation(fields: [pustakaId], references: [id], onDelete: Cascade)

  @@id([pertemuanId, pustakaId])
  @@map("pertemuan_pustaka")
}

/// Bagian E template ITTS: komponen nilai beserta bobotnya. Total wajib 100%.
model KomponenNilai {
  id      String    @id @default(cuid())
  rpkpsId String    @map("rpkps_id")
  nama    String
  /// Terjemahan tampilan. SENGAJA di luar @@unique di bawah: menjadikannya
  /// bagian kunci berarti mengubah terjemahan melepas seluruh tautan asesmen
  /// (docs/11 §5.2).
  namaEn  String?   @map("nama_en")
  bobot   Decimal   @db.Decimal(5, 2)
  urutan  Int       @default(0)
  sumber  SumberIsi @default(KURIKULUM)

  rpkps     Rpkps       @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  pertemuan Pertemuan[]
  tugas     Tugas[]

  @@unique([rpkpsId, nama])
  @@map("komponen_nilai")
}

/// Bagian J template ITTS: histori revisi.
model RpkpsRiwayat {
  id         String      @id @default(cuid())
  rpkpsId    String      @map("rpkps_id")
  versi      Int
  status     StatusRpkps
  /// Peristiwanya: { kunci, params }. Kalimatnya dirakit saat DIBACA — baris
  /// riwayat hidup jauh lebih lama daripada sesi yang menulisnya, dan ikut
  /// tampil di katalog publik (docs/11 §4.2c).
  data       Json?
  /// Cadangan bahasa Indonesia. Salinan beku yang dibuat sebelum L3 hanya
  /// punya ini, dan salinan beku tidak pernah ditulis ulang.
  deskripsi  String
  olehId     String?     @map("oleh_id")
  dibuatPada DateTime    @default(now()) @map("dibuat_pada")

  rpkps Rpkps @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)

  @@index([rpkpsId])
  @@map("rpkps_riwayat")
}

// ─────────────────────────────────────────────────────────────
// TUGAS / PROYEK — bagian I template ITTS
// Struktur mengikuti dokumen asli TI214: identitas tugas, uraian,
// format & luaran, tabel indikator berbobot, dan linimasa mingguan.
// ─────────────────────────────────────────────────────────────

enum JenisTugas {
  INDIVIDU
  KELOMPOK
}

model Tugas {
  id      String @id @default(cuid())
  rpkpsId String @map("rpkps_id")
  nomor   Int

  nama            String
  namaEn          String?    @map("nama_en")
  jenis           JenisTugas @default(INDIVIDU)
  /// Rentang minggu pelaksanaan, mis. 9–16.
  mingguMulai     Int        @map("minggu_mulai")
  mingguSelesai   Int        @map("minggu_selesai")
  /// Bobot terhadap nilai akhir. Terikat ke satu komponen nilai agar
  /// tidak menjadi bobot ketiga yang berdiri sendiri.
  komponenNilaiId String?    @map("komponen_nilai_id")
  bobot           Decimal    @default(0) @db.Decimal(5, 2)

  deskripsi       String
  deskripsiEn     String?   @map("deskripsi_en")
  uraianTugas     String?   @map("uraian_tugas")
  uraianTugasEn   String?   @map("uraian_tugas_en")
  formatLuaran    String?   @map("format_luaran")
  formatLuaranEn  String?   @map("format_luaran_en")
  ketentuanLain   String?   @map("ketentuan_lain")
  ketentuanLainEn String?   @map("ketentuan_lain_en")
  sumber          SumberIsi @default(KURIKULUM)

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  rpkps         Rpkps           @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  komponenNilai KomponenNilai?  @relation(fields: [komponenNilaiId], references: [id], onDelete: SetNull)
  subCpmk       TugasSubCpmk[]
  kriteria      KriteriaTugas[]
  linimasa      LinimasaTugas[]

  @@unique([rpkpsId, nomor])
  @@index([rpkpsId])
  @@map("tugas")
}

model TugasSubCpmk {
  tugasId   String @map("tugas_id")
  subCpmkId String @map("sub_cpmk_id")

  tugas   Tugas   @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  subCpmk SubCpmk @relation(fields: [subCpmkId], references: [id], onDelete: Cascade)

  @@id([tugasId, subCpmkId])
  @@map("tugas_sub_cpmk")
}

/// Baris tabel "Indikator, Kriteria, dan Bobot Penilaian". Totalnya wajib 100%.
model KriteriaTugas {
  id          String   @id @default(cuid())
  tugasId     String   @map("tugas_id")
  nomor       Int
  indikator   String
  indikatorEn String?  @map("indikator_en")
  /// Butir-butir penjelas di bawah indikator, dicetak sebagai daftar.
  rincian     String[]
  rincianEn   String[] @map("rincian_en")
  bobot       Decimal  @db.Decimal(5, 2)

  tugas Tugas @relation(fields: [tugasId], references: [id], onDelete: Cascade)

  @@unique([tugasId, nomor])
  @@map("kriteria_tugas")
}

/// Baris tabel "Linimasa Proyek/Tugas".
model LinimasaTugas {
  id          String  @id @default(cuid())
  tugasId     String  @map("tugas_id")
  minggu      Int
  tahapan     String
  tahapanEn   String? @map("tahapan_en")
  aktivitas   String
  aktivitasEn String? @map("aktivitas_en")

  tugas Tugas @relation(fields: [tugasId], references: [id], onDelete: Cascade)

  @@unique([tugasId, minggu])
  @@map("linimasa_tugas")
}

/// Salinan beku RPKPS pada saat diterbitkan.
///
/// Tanpa ini, dokumen yang sudah ditandatangani ikut berubah begitu kurikulum
/// disunting — rumusan CPMK diperbaiki, Sub-CPMK ditambah — sehingga berkas
/// yang dicetak hari ini tidak lagi sama dengan yang disahkan Kaprodi.
/// Untuk keperluan akreditasi, itu tidak dapat diterima.
model RpkpsSnapshot {
  id         String   @id @default(cuid())
  rpkpsId    String   @map("rpkps_id")
  versi      Int
  /// Seluruh isi dokumen pada saat terbit, termasuk CPL/CPMK/Sub-CPMK.
  isi        Json
  /// SHA-256 atas serialisasi kanonik `isi`. Dicetak pada dokumen sebagai
  /// sidik yang dapat diverifikasi ulang.
  sidik      String
  /// Salinan beku berbahasa Inggris, dari `proyeksiIsiEn()`. Null berarti
  /// dokumen ini tidak diterbitkan berbahasa Inggris — halaman `/en/katalog`
  /// menampilkan versi Indonesia beserta keterangannya (docs/11 §6.3).
  isiEn      Json?    @map("isi_en")
  /// Sidik ruang KEDUA, atas `isiEn`. Sengaja terpisah dari `sidik`:
  /// menambahkan medan Inggris ke ruang sidik pertama akan menggeser sidik
  /// SELURUH dokumen yang sudah ditandatangani (docs/11 §6.1).
  sidikEn    String?  @map("sidik_en")
  olehId     String?  @map("oleh_id")
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  rpkps Rpkps @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)

  @@unique([rpkpsId, versi])
  @@index([rpkpsId])
  @@map("rpkps_snapshot")
}

// ─────────────────────────────────────────────────────────────
// KISI-KISI UJIAN — lampiran template ITTS
// Acuan: docs/00-konsep-rpkps.md §3.5
//
// Menjembatani rencana dan penilaian: tiap butir soal terikat ke satu
// Sub-CPMK dan satu level Bloom, sehingga skor butir dapat mengalir
// langsung ke perhitungan ketercapaian CPMK tanpa pemetaan ulang.
// ─────────────────────────────────────────────────────────────

enum JenisUjian {
  UTS
  UAS
}

enum BentukSoal {
  PILIHAN_GANDA
  ESAI
  URAIAN_SINGKAT
  STUDI_KASUS
  PRAKTIK
  PROYEK
  LISAN
}

model KisiKisi {
  id          String     @id @default(cuid())
  rpkpsId     String     @map("rpkps_id")
  jenis       JenisUjian
  /// Total skor seluruh butir; lazimnya 100.
  totalSkor   Decimal    @default(100) @map("total_skor") @db.Decimal(6, 2)
  durasiMenit Int?       @map("durasi_menit")
  catatan     String?
  catatanEn   String?    @map("catatan_en")
  sumber      SumberIsi  @default(KURIKULUM)

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  rpkps Rpkps           @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  butir ButirKisiKisi[]

  @@unique([rpkpsId, jenis])
  @@map("kisi_kisi")
}

model ButirKisiKisi {
  id          String     @id @default(cuid())
  kisiKisiId  String     @map("kisi_kisi_id")
  nomor       Int
  subCpmkId   String     @map("sub_cpmk_id")
  levelBloom  LevelBloom @map("level_bloom")
  bentuk      BentukSoal @default(ESAI)
  /// Berapa butir soal untuk baris ini.
  jumlahButir Int        @default(1) @map("jumlah_butir")
  /// Skor total baris ini terhadap totalSkor kisi-kisi.
  skor        Decimal    @db.Decimal(6, 2)
  indikator   String?
  indikatorEn String?    @map("indikator_en")

  kisiKisi KisiKisi     @relation(fields: [kisiKisiId], references: [id], onDelete: Cascade)
  subCpmk  SubCpmk      @relation(fields: [subCpmkId], references: [id], onDelete: Restrict)
  nilai    NilaiButir[]

  @@unique([kisiKisiId, nomor])
  @@index([subCpmkId])
  @@map("butir_kisi_kisi")
}

// ─────────────────────────────────────────────────────────────
// USULAN REVISI KURIKULUM
// Acuan: docs/04-usulan-revisi-kurikulum.md
//
// Satu-satunya pintu resmi mengubah CPMK/Sub-CPMK. Dosen mengusulkan,
// domain memeriksa, Kaprodi memutuskan per butir, sistem menerapkan.
// Usulan disimpan BERBUTIR (bukan prosa) supaya pengesahan dapat
// diterapkan kode secara deterministik — lihat doc 04 §2.1.
// ─────────────────────────────────────────────────────────────

enum StatusUsulan {
  DRAF
  DIAJUKAN
  DIREVISI
  DISETUJUI
  DITERAPKAN
  DITOLAK
  DITARIK
}

/// Keputusan Kaprodi atas satu butir. DISESUAIKAN = diterima setelah
/// rumusannya disunting Kaprodi, sehingga kalimat akhir tetap miliknya.
enum StatusButir {
  BARU
  DITERIMA
  DISESUAIKAN
  DITOLAK
}

enum JenisButir {
  CPMK_BARU
  CPMK_RUMUSAN
  CPMK_PETA_CPL
  CPMK_PENSIUN
  SUB_BARU
  SUB_RUMUSAN
  SUB_MINGGU
  SUB_PENSIUN
  /// Usulan yang menyentuh CPL/profil lulusan — DI LUAR kewenangan URK.
  /// Tidak pernah diterapkan otomatis; hanya bahan evaluasi kurikulum
  /// berikutnya (doc 04 §2.2).
  CATATAN_CPL
}

/// Dari mana sebuah butir mendapat pembenarannya. Butir tanpa satu pun
/// dasar ditolak validator sebelum sampai ke Kaprodi (doc 04 §2.3) —
/// inilah yang memisahkan revisi berbasis bukti dari karangan model.
enum JenisDasar {
  TEMUAN_VALIDATOR
  SINYAL_INDUSTRI
  MASUKAN_DUDI
  TRACER
  CATATAN_DOSEN
  /// Temuan evaluasi ketercapaian (doc 05 §5.6). `ref` berisi id
  /// TemuanEvaluasi — inilah sambungan yang menutup siklus PPEPP.
  TEMUAN_EVALUASI
}

model UsulanRevisi {
  id           String @id @default(cuid())
  kurikulumId  String @map("kurikulum_id")
  mataKuliahId String @map("mata_kuliah_id")
  judul        String
  /// Latar belakang: mengapa revisi ini perlu. Dibaca Kaprodi lebih dulu.
  latar        String

  status StatusUsulan @default(DRAF)

  /// Jalur ralat: perbaikan ejaan yang TIDAK mengubah makna, boleh berlaku
  /// segera. Syaratnya ditegakkan kode, bukan janji pengusul — lihat
  /// `periksaJalurRalat` di src/domain/kurikulum/usulan.ts.
  jalurRalat Boolean @default(false) @map("jalur_ralat")

  diajukanOlehId   String    @map("diajukan_oleh_id")
  diajukanPada     DateTime? @map("diajukan_pada")
  diputuskanOlehId String?   @map("diputuskan_oleh_id")
  diputuskanPada   DateTime? @map("diputuskan_pada")
  catatanPemutus   String?   @map("catatan_pemutus")

  /// Tahun akademik mulai berlakunya revisi. Baku: TA aktif berikutnya,
  /// agar semester berjalan tidak terganggu (doc 04 §2.5).
  berlakuMulaiTaId String?   @map("berlaku_mulai_ta_id")
  diterapkanPada   DateTime? @map("diterapkan_pada")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  kurikulum      Kurikulum        @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  mataKuliah     MataKuliah       @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  diajukanOleh   Pengguna         @relation("UsulanDiajukan", fields: [diajukanOlehId], references: [id], onDelete: Restrict)
  diputuskanOleh Pengguna?        @relation("UsulanDiputuskan", fields: [diputuskanOlehId], references: [id], onDelete: SetNull)
  berlakuMulaiTa TahunAkademik?   @relation("UsulanBerlaku", fields: [berlakuMulaiTaId], references: [id], onDelete: Restrict)
  butir          ButirUsulan[]
  catatan        CatatanUsulan[]
  revisi         RevisiKurikulum?
  temuanEvaluasi TemuanEvaluasi[]

  @@index([kurikulumId, status])
  @@index([mataKuliahId])
  @@index([status])
  @@map("usulan_revisi")
}

model ButirUsulan {
  id       String      @id @default(cuid())
  usulanId String      @map("usulan_id")
  urutan   Int         @default(0)
  jenis    JenisButir
  status   StatusButir @default(BARU)

  /// Sasaran butir. Untuk CPMK_BARU/SUB_BARU ini kode yang DIUSULKAN;
  /// untuk jenis lain, kode yang sudah ada di kurikulum.
  cpmkKode    String  @map("cpmk_kode")
  subCpmkKode String? @map("sub_cpmk_kode")

  rumusan          String?
  rumusanEn        String?     @map("rumusan_en")
  levelBloom       LevelBloom? @map("level_bloom")
  kko              String?
  /// Untuk CPMK_BARU dan CPMK_PETA_CPL.
  cplKode          String[]    @map("cpl_kode")
  /// Untuk SUB_BARU dan SUB_MINGGU.
  mingguDisarankan Int[]       @map("minggu_disarankan")

  /// Mengapa butir ini diusulkan. Wajib — Kaprodi perlu dasar menilai.
  alasan         String
  catatanPemutus String? @map("catatan_pemutus")

  /// KURIKULUM = disusun manusia, AI = lahir dari draf model. Ditahan apa
  /// adanya setelah disahkan; asesor berhak tahu (docs/01 §4.8).
  sumber SumberIsi @default(KURIKULUM)

  /// Terisi saat butir diterapkan — jejak balik dari kurikulum ke usulannya.
  cpmkId    String? @map("cpmk_id")
  subCpmkId String? @map("sub_cpmk_id")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  usulan  UsulanRevisi @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  dasar   DasarButir[]
  cpmk    Cpmk?        @relation(fields: [cpmkId], references: [id], onDelete: SetNull)
  subCpmk SubCpmk?     @relation(fields: [subCpmkId], references: [id], onDelete: SetNull)

  @@index([usulanId])
  @@map("butir_usulan")
}

model DasarButir {
  id      String     @id @default(cuid())
  butirId String     @map("butir_id")
  jenis   JenisDasar
  /// Id entitas sumber (sinyal industri, masukan DUDI, tracer) atau kode
  /// temuan validator. Kosong hanya untuk CATATAN_DOSEN.
  ref     String?
  kutipan String

  butir ButirUsulan @relation(fields: [butirId], references: [id], onDelete: Cascade)

  @@index([butirId])
  @@map("dasar_butir")
}

/// Diskusi pada usulan. Kanal catatan mutu GPM (yang tidak memblokir),
/// sekaligus tempat pengusul menjawab.
model CatatanUsulan {
  id         String   @id @default(cuid())
  usulanId   String   @map("usulan_id")
  olehId     String?  @map("oleh_id")
  isi        String
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  usulan UsulanRevisi @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  oleh   Pengguna?    @relation(fields: [olehId], references: [id], onDelete: SetNull)

  @@index([usulanId])
  @@map("catatan_usulan")
}

/// Ledger penerapan: satu baris per usulan yang disahkan. Sumber angka
/// "Revisi ke-N" pada halaman kurikulum dan bahan jawaban asesor.
model RevisiKurikulum {
  id               String   @id @default(cuid())
  kurikulumId      String   @map("kurikulum_id")
  revisiKe         Int      @map("revisi_ke")
  usulanId         String   @unique @map("usulan_id")
  ringkasan        String
  /// Diisi bila pengaju dan pengesah adalah orang yang sama. Bukan
  /// larangan — penandaan (doc 04 §8.1).
  disahkanSendiri  Boolean  @default(false) @map("disahkan_sendiri")
  olehId           String?  @map("oleh_id")
  berlakuMulaiTaId String?  @map("berlaku_mulai_ta_id")
  dibuatPada       DateTime @default(now()) @map("dibuat_pada")

  kurikulum      Kurikulum      @relation(fields: [kurikulumId], references: [id], onDelete: Cascade)
  usulan         UsulanRevisi   @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  oleh           Pengguna?      @relation(fields: [olehId], references: [id], onDelete: SetNull)
  berlakuMulaiTa TahunAkademik? @relation("RevisiBerlaku", fields: [berlakuMulaiTaId], references: [id], onDelete: Restrict)

  @@unique([kurikulumId, revisiKe])
  @@index([kurikulumId])
  @@map("revisi_kurikulum")
}

// ─────────────────────────────────────────────────────────────
// KELAS, MAHASISWA, DAN NILAI
// Acuan: docs/05-evaluasi-ketercapaian-mk.md §5.1–5.2, tahap E2.
//
// Ketercapaian SELALU milik kelas, bukan milik dokumen rencana: satu RPKPS
// dipakai kelas A/B/C dengan dosen berbeda, dan menggabungkan nilainya
// menyembunyikan justru temuan yang paling berguna — rencana yang sama
// menghasilkan capaian yang jauh berbeda berarti yang bermasalah adalah
// pelaksanaan, bukan rancangan (doc 05 §4.1b).
//
// Data mahasiswa sengaja dibatasi empat kolom. Cukup untuk menghitung sebaran
// dan menelusuri sampel jawaban saat asesor bertanya; tidak cukup untuk
// berubah menjadi SIAKAD bayangan.
// ─────────────────────────────────────────────────────────────

model Kelas {
  id      String  @id @default(cuid())
  rpkpsId String  @map("rpkps_id")
  /// "A", "B", "Pagi" — mengikuti kebiasaan prodi.
  kode    String
  dosenId String? @map("dosen_id")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  rpkps    Rpkps          @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  dosen    Pengguna?      @relation("KelasDosen", fields: [dosenId], references: [id], onDelete: SetNull)
  peserta  PesertaKelas[]
  evaluasi EvaluasiMk?

  @@unique([rpkpsId, kode])
  @@index([rpkpsId])
  @@map("kelas")
}

model Mahasiswa {
  id       String @id @default(cuid())
  prodiId  String @map("prodi_id")
  nim      String
  nama     String
  /// Opsional: banyak berkas nilai hanya memuat NIM dan nama.
  angkatan Int?

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  prodi Prodi          @relation(fields: [prodiId], references: [id], onDelete: Cascade)
  kelas PesertaKelas[]

  @@unique([prodiId, nim])
  @@index([prodiId, angkatan])
  @@map("mahasiswa")
}

model PesertaKelas {
  id          String @id @default(cuid())
  kelasId     String @map("kelas_id")
  mahasiswaId String @map("mahasiswa_id")

  kelas      Kelas          @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mahasiswa  Mahasiswa      @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  nilai      NilaiAsesmen[]
  nilaiButir NilaiButir[]

  @@unique([kelasId, mahasiswaId])
  @@index([kelasId])
  @@map("peserta_kelas")
}

/// Skor mentah satu mahasiswa pada satu asesmen, skala 0–100.
///
/// `asesmenKode` sengaja BUKAN relasi. Asesmen adalah proyeksi yang disusun
/// `susunPetaAsesmen` dari tabel mingguan, lembar tugas, dan kisi-kisi — ia
/// tidak punya baris sendiri, dan tidak boleh punya, atau bobot mendapat
/// tempat penyimpanan keempat (doc 05 §5.3). Kodenya stabil karena diturunkan
/// dari nomor minggu dan nomor tugas: `M5`, `T1`, `UTS`, `UAS`.
model NilaiAsesmen {
  id             String  @id @default(cuid())
  pesertaKelasId String  @map("peserta_kelas_id")
  asesmenKode    String  @map("asesmen_kode")
  skor           Decimal @db.Decimal(6, 2)

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  peserta PesertaKelas @relation(fields: [pesertaKelasId], references: [id], onDelete: Cascade)

  @@unique([pesertaKelasId, asesmenKode])
  @@index([pesertaKelasId])
  @@map("nilai_asesmen")
}

// ─────────────────────────────────────────────────────────────
// EVALUASI KETERCAPAIAN DAN TINDAK LANJUT
// Acuan: docs/05-evaluasi-ketercapaian-mk.md §5.5–5.6, tahap E3–E4.
//
// Evaluasi menempel pada KELAS, bukan pada RPKPS: satu dokumen rencana
// dipakai beberapa kelas, dan sebaran antar kelas itu sendiri adalah temuan.
//
// Hasil evaluasi TIDAK PERNAH masuk `proyeksiIsi()`. Menambahkannya akan
// menggeser sidik SHA-256 seluruh RPKPS terbit dan memunculkan peringatan
// pergeseran palsu. Evaluasi adalah dokumen BERDAMPINGAN dengan sidiknya
// sendiri, bukan bagian dari RPKPS.
// ─────────────────────────────────────────────────────────────

enum StatusEvaluasi {
  DRAF
  DIHITUNG
  DITUTUP
}

enum TingkatCapaian {
  SUB_CPMK
  CPMK
  CPL
}

enum StatusVerifikasi {
  BELUM
  TERCAPAI
  TIDAK_TERCAPAI
}

model EvaluasiMk {
  id      String         @id @default(cuid())
  kelasId String         @unique @map("kelas_id")
  status  StatusEvaluasi @default(DRAF)
  versi   Int            @default(1)

  /// Ambang DISALIN saat evaluasi ditutup, tidak dibaca ulang dari RPKPS.
  /// Kalau prodi mengubah ambangnya tahun depan, catatan tahun ini tetap
  /// dapat dibaca dengan aturan yang berlaku saat itu.
  ambangKelulusanMhs   Decimal @default(55) @map("ambang_kelulusan_mhs") @db.Decimal(5, 2)
  ambangKetercapaianMk Decimal @default(85) @map("ambang_ketercapaian_mk") @db.Decimal(5, 2)

  /// Refleksi dosen atas pelaksanaan: apa yang berjalan, apa yang tidak.
  /// Inilah lapisan L3 pada doc 05 §2 — yang tidak dapat dihitung mesin.
  catatanProses String? @map("catatan_proses")

  ditutupOlehId String?   @map("ditutup_oleh_id")
  ditutupPada   DateTime? @map("ditutup_pada")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  kelas       Kelas              @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  ditutupOleh Pengguna?          @relation("EvaluasiDitutup", fields: [ditutupOlehId], references: [id], onDelete: SetNull)
  hasil       HasilCapaian[]
  temuan      TemuanEvaluasi[]
  snapshot    EvaluasiSnapshot[]

  @@index([status])
  @@map("evaluasi_mk")
}

/// Capaian per butir pada saat evaluasi ditutup. Disimpan sebagai baris, bukan
/// hanya di dalam snapshot, supaya agregasi tingkat prodi (E5) dapat mengkueri
/// tanpa membongkar JSON satu per satu.
model HasilCapaian {
  id            String         @id @default(cuid())
  evaluasiId    String         @map("evaluasi_id")
  tingkat       TingkatCapaian
  kode          String
  rerata        Decimal?       @db.Decimal(6, 2)
  persenLulus   Decimal?       @map("persen_lulus") @db.Decimal(5, 2)
  tercapai      Boolean        @default(false)
  pita          String
  jumlahDinilai Int            @default(0) @map("jumlah_dinilai")

  evaluasi EvaluasiMk @relation(fields: [evaluasiId], references: [id], onDelete: Cascade)

  @@unique([evaluasiId, tingkat, kode])
  @@index([evaluasiId])
  @@map("hasil_capaian")
}

/// Salinan beku hasil evaluasi. Nilai berubah setelah remedial, ralat entri,
/// atau susulan; laporan akreditasi harus dapat diulang persis.
model EvaluasiSnapshot {
  id         String   @id @default(cuid())
  evaluasiId String   @map("evaluasi_id")
  versi      Int
  isi        Json
  /// SHA-256 atas serialisasi kanonik `isi`, dihitung mesin sidik yang sama
  /// dengan RPKPS — tetapi atas ruang yang terpisah sama sekali.
  sidik      String
  olehId     String?  @map("oleh_id")
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  evaluasi EvaluasiMk @relation(fields: [evaluasiId], references: [id], onDelete: Cascade)

  @@unique([evaluasiId, versi])
  @@index([evaluasiId])
  @@map("evaluasi_snapshot")
}

/// Temuan beserta rencana tindak lanjutnya — huruf P kedua dan ketiga pada
/// PPEPP. Inilah satu-satunya bagian yang tidak dapat dihitung mesin, dan
/// yang paling dicari asesor (doc 05 §2, §5.6).
model TemuanEvaluasi {
  id         String         @id @default(cuid())
  evaluasiId String         @map("evaluasi_id")
  tingkat    TingkatCapaian
  kode       String

  /// Persen mahasiswa lulus saat temuan dibuat. Dibekukan di sini agar
  /// verifikasi semester berikutnya punya pembanding yang jelas.
  capaianTerukur Decimal? @map("capaian_terukur") @db.Decimal(5, 2)

  akarMasalah String @map("akar_masalah")
  tindakan    String

  penanggungJawabId String? @map("penanggung_jawab_id")
  /// Tahun akademik saat tindakan ini dijadwalkan berlaku.
  taSasaranId       String? @map("ta_sasaran_id")

  statusVerifikasi   StatusVerifikasi @default(BELUM) @map("status_verifikasi")
  catatanVerifikasi  String?          @map("catatan_verifikasi")
  diverifikasiPada   DateTime?        @map("diverifikasi_pada")
  diverifikasiOlehId String?          @map("diverifikasi_oleh_id")

  /// Terisi bila temuan ini diteruskan menjadi Usulan Revisi Kurikulum.
  /// Inilah sambungan yang menutup siklus (doc 05 §5.6).
  usulanId String? @map("usulan_id")

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  evaluasi         EvaluasiMk     @relation(fields: [evaluasiId], references: [id], onDelete: Cascade)
  penanggungJawab  Pengguna?      @relation("TemuanPenanggungJawab", fields: [penanggungJawabId], references: [id], onDelete: SetNull)
  taSasaran        TahunAkademik? @relation("TemuanSasaran", fields: [taSasaranId], references: [id], onDelete: SetNull)
  diverifikasiOleh Pengguna?      @relation("TemuanDiverifikasi", fields: [diverifikasiOlehId], references: [id], onDelete: SetNull)
  usulan           UsulanRevisi?  @relation(fields: [usulanId], references: [id], onDelete: SetNull)

  @@unique([evaluasiId, tingkat, kode])
  @@index([evaluasiId])
  @@index([statusVerifikasi])
  @@map("temuan_evaluasi")
}

/// Skor satu mahasiswa pada satu baris kisi-kisi — bahan analisis butir (E6).
///
/// Terpisah dari `NilaiAsesmen` dengan sengaja. `NilaiAsesmen` menyimpan skor
/// UTS sebagai satu angka karena itulah yang masuk perhitungan capaian;
/// analisis butir butuh angka per soal, dan itu data yang jauh lebih rinci
/// serta OPSIONAL — banyak dosen tidak merekamnya, dan capaian tetap dapat
/// dihitung tanpanya.
model NilaiButir {
  id              String  @id @default(cuid())
  pesertaKelasId  String  @map("peserta_kelas_id")
  butirKisiKisiId String  @map("butir_kisi_kisi_id")
  skor            Decimal @db.Decimal(6, 2)

  dibuatPada DateTime @default(now()) @map("dibuat_pada")
  diubahPada DateTime @updatedAt @map("diubah_pada")

  peserta PesertaKelas  @relation(fields: [pesertaKelasId], references: [id], onDelete: Cascade)
  butir   ButirKisiKisi @relation(fields: [butirKisiKisiId], references: [id], onDelete: Cascade)

  @@unique([pesertaKelasId, butirKisiKisiId])
  @@index([butirKisiKisiId])
  @@map("nilai_butir")
}

// ─────────────────────────────────────────────────────────────
// BAHAN AJAR — docs/16
//
// Buku ajar dan slide yang disusun dari baris mingguan RPKPS. BERDAMPINGAN
// dengan RPKPS, bukan bagian isinya: tidak masuk `proyeksiIsi()`, tidak masuk
// `rpkps_snapshot`, tidak ikut rantai pengesahan, dan karena itu tidak pernah
// menggeser sidik dokumen yang sudah terbit (docs/16 P1).
//
// Tidak ada satu pun kolom `*En` di sini, dan itu disengaja. Buku memilih
// bahasanya sekali lewat `buku_ajar.bahasa`; satu RPKPS boleh punya dua buku
// yang isinya ditulis terpisah. Teks bab terlalu panjang untuk ikut mesin
// terjemahan medan-per-medan docs/11, dan mencampurkannya akan membuat angka
// kelengkapan terjemahan RPKPS mengukur pekerjaan menulis buku (docs/16 P7).
// ─────────────────────────────────────────────────────────────

model BukuAjar {
  id      String          @id @default(cuid())
  rpkpsId String          @map("rpkps_id")
  bahasa  BahasaAntarmuka @default(id)

  /// Metadata terbitan. Diisi dosen, TIDAK PERNAH oleh AI: skema keluaran
  /// tugas `BUKU_*` tidak punya medan ini sama sekali. Nomor ISBN karangan
  /// yang tercetak di halaman hak cipta tidak dapat ditarik kembali setelah
  /// bukunya beredar (docs/16 P5).
  judul       String
  subjudul    String?
  penulis     String[]
  afiliasi    String?
  penerbit    String?
  kotaTerbit  String?  @map("kota_terbit")
  tahunTerbit Int?     @map("tahun_terbit")
  edisi       String?
  isbn        String?
  hakCipta    String?  @map("hak_cipta")

  /// Kelengkapan yang boleh didraf AI lalu disunting dosen.
  prakata     String?
  pendahuluan String?
  /// [{ istilah, arti }] — daftar, bukan kalimat, supaya dapat diurutkan dan
  /// dicetak sebagai glosarium tanpa mengurai teks bebas.
  glosarium   Json?
  biografi    String?

  sumber     SumberIsi @default(AI)
  dibuatPada DateTime  @default(now()) @map("dibuat_pada")
  diubahPada DateTime  @updatedAt @map("diubah_pada")

  rpkps Rpkps         @relation(fields: [rpkpsId], references: [id], onDelete: Cascade)
  bab   BabBukuAjar[]

  @@unique([rpkpsId, bahasa])
  @@index([rpkpsId])
  @@map("buku_ajar")
}

/// Satu bab = satu baris mingguan EFEKTIF. Minggu UTS dan UAS tidak melahirkan
/// bab: tidak ada materi yang diajarkan di sana.
model BabBukuAjar {
  id          String  @id @default(cuid())
  bukuAjarId  String  @map("buku_ajar_id")
  /// Baris mingguan asalnya. SetNull, BUKAN Cascade: bab yang sudah ditulis
  /// dan disunting dosen tidak boleh lenyap karena baris mingguannya disusun
  /// ulang. Bab yang kehilangan minggunya ditandai `BA-MINGGU-HILANG`.
  pertemuanId String? @map("pertemuan_id")

  nomor      Int
  judul      String
  tujuan     String[]
  /// Satu kalimat dari tahap kerangka: apa yang dikerjakan bab ini dalam alur
  /// buku. Disimpan karena bab ditulis satu per satu pada panggilan terpisah —
  /// kalimat inilah yang menjaga bab-bab tidak saling mengulang.
  alur       String?
  uraian     String?
  studiKasus String?  @map("studi_kasus")
  ringkasan  String?

  /// Sidik rencana minggu SAAT bab disusun — topik, subtopik, indikator, dan
  /// kode Sub-CPMK. Bila RPKPS bergerak sesudahnya, layar menandai bab ini
  /// "disusun dari rencana yang sudah berubah" (`BA-BAB-BERGESER`). Ini
  /// penanda, bukan gerbang: bab tidak pernah ditulis ulang otomatis.
  sidikSumber String? @map("sidik_sumber")

  sumber        SumberIsi @default(AI)
  /// Diisi saat manusia menyimpan suntingannya. `null` berarti bab masih
  /// murni keluaran model — yang menyalakan `BA-SELURUHNYA-AI`.
  disuntingPada DateTime? @map("disunting_pada")
  dibuatPada    DateTime  @default(now()) @map("dibuat_pada")
  /// Kunci optimistik. Penyunting bab menulis ulang SELURUH isinya beserta
  /// latihan dan slide, jadi tanpa cap ini dua penyunting saling menimpa
  /// tanpa gejala — aturan yang sama dengan `simpanPertemuan`.
  diubahPada    DateTime  @updatedAt @map("diubah_pada")

  buku      BukuAjar     @relation(fields: [bukuAjarId], references: [id], onDelete: Cascade)
  pertemuan Pertemuan?   @relation(fields: [pertemuanId], references: [id], onDelete: SetNull)
  latihan   LatihanBab[]
  slide     SlideBab[]
  pustaka   BabPustaka[]

  @@unique([bukuAjarId, nomor])
  @@index([bukuAjarId])
  @@index([pertemuanId])
  @@map("bab_buku_ajar")
}

/// Soal latihan satu bab.
model LatihanBab {
  id    String      @id @default(cuid())
  babId String      @map("bab_id")
  nomor Int
  soal  String
  /// Kolomnya sendiri, terpisah dari `soal`, supaya berkas untuk mahasiswa
  /// (`?kunci=0`) dapat dicetak tanpa menyunting apa pun. Menggabungkannya ke
  /// satu kolom teks membuat kunci jawaban ikut terbagikan, dan gagalnya
  /// senyap (docs/16 §4.1).
  kunci String?
  bloom LevelBloom?

  bab BabBukuAjar @relation(fields: [babId], references: [id], onDelete: Cascade)

  @@unique([babId, nomor])
  @@map("latihan_bab")
}

/// Satu slide presentasi. `catatan` menjadi speaker notes pada .pptx dan tidak
/// pernah ikut ke badan slide.
model SlideBab {
  id      String   @id @default(cuid())
  babId   String   @map("bab_id")
  nomor   Int
  judul   String
  butir   String[]
  catatan String?

  bab BabBukuAjar @relation(fields: [babId], references: [id], onDelete: Cascade)

  @@unique([babId, nomor])
  @@map("slide_bab")
}

/// Pustaka RPKPS yang disitir sebuah bab. Daftar pustaka buku dirakit dari
/// baris `pustaka` yang ditunjuk di sini — bukan dari karangan model
/// (docs/16 P6).
model BabPustaka {
  babId     String @map("bab_id")
  pustakaId String @map("pustaka_id")

  bab     BabBukuAjar @relation(fields: [babId], references: [id], onDelete: Cascade)
  pustaka Pustaka     @relation(fields: [pustakaId], references: [id], onDelete: Cascade)

  @@id([babId, pustakaId])
  @@map("bab_pustaka")
}
